# ==============================================================================
# BalanceVault - Global Environment Variables Template
# Copy this file to .env or use separate backend/.env and frontend/.env
# ==============================================================================

# Server Configuration
PORT=5000
NODE_ENV=development

# Frontend Client URL (for CORS policy)
CORS_ORIGIN=http://localhost:5173

# Database Connection (PostgreSQL)
# Format: postgresql://[USER]:[PASSWORD]@[HOST]:[PORT]/[DATABASE]?schema=public
# Windows local default example:
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/balancevault?schema=public"

# Redis Configuration (For rate limiting & ephemeral session caching)
# Windows options:
# 1. Native Windows Redis / Memurai: redis://localhost:6379
# 2. Redis on WSL2: redis://127.0.0.1:6379
# 3. Cloud/Hosted Redis (e.g., Upstash, Redis Cloud)
REDIS_URL="redis://127.0.0.1:6379"

# Security & Authentication (Argon2 / JWT)
# Minimum 32-character high-entropy secret
JWT_SECRET="balancevault-super-secure-dev-secret-change-in-production-min-32-chars"
JWT_EXPIRES_IN="1d"
JWT_REFRESH_SECRET="balancevault-refresh-dev-secret-change-in-production-min-32-chars"
JWT_REFRESH_EXPIRES_IN="7d"

# Rate Limiting Parameters
RATE_LIMIT_WINDOW_MS=900000 # 15 minutes in milliseconds
RATE_LIMIT_MAX_REQUESTS=100  # Max requests per window per IP

