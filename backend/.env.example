# BalanceVault Backend Environment Variables
PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# Database URL (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/balancevault_db?schema=public"

# Redis URL (Rate limiting & caching)
REDIS_URL="redis://127.0.0.1:6379"

# Security (Argon2 / JWT)
JWT_SECRET="balancevault-super-secure-dev-secret-change-in-production-min-32-chars"
JWT_EXPIRES_IN="1d"
JWT_REFRESH_SECRET="balancevault-refresh-dev-secret-change-in-production-min-32-chars"
JWT_REFRESH_EXPIRES_IN="7d"

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# First Admin Bootstrap Secret (Used only once to initialize the root administrator)
ADMIN_BOOTSTRAP_SECRET="balancevault_super_admin_bootstrap_secret_2026"

