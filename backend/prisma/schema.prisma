// BalanceVault Prisma Schema
// Money movement with a ledger you can prove

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  ACCOUNT_HOLDER
  AUDITOR
}

enum UserStatus {
  PENDING_ONBOARDING
  ACTIVE
  SUSPENDED
  REJECTED
}

enum AccountType {
  CHECKING
  SAVINGS
  SYSTEM_SETTLEMENT
}

enum AccountStatus {
  ACTIVE
  FROZEN
  CLOSED
}

enum TransactionType {
  DEPOSIT
  WITHDRAWAL
  TRANSFER
}

enum TransactionStatus {
  PENDING
  POSTED
  REJECTED
}

enum LedgerDirection {
  DEBIT
  CREDIT
}

model User {
  id           String      @id @default(uuid())
  email        String      @unique
  passwordHash String
  fullName     String
  role         Role        @default(ACCOUNT_HOLDER)
  status       UserStatus  @default(PENDING_ONBOARDING)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  accounts     Account[]
  initiatedTxs JournalTransaction[] @relation("TransactionInitiator")
  auditLogs    AuditLog[]           @relation("UserAuditLogs")

  @@index([email])
  @@index([role])
  @@index([status])
  @@map("users")
}

model Account {
  id            String        @id @default(uuid())
  accountNumber String        @unique
  userId        String
  currency      String        @default("USD")
  type          AccountType   @default(CHECKING)
  status        AccountStatus @default(ACTIVE)
  balance       Decimal       @default(0.0000) @db.Decimal(18, 4)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  user          User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  ledgerEntries LedgerEntry[]

  @@index([accountNumber])
  @@index([userId])
  @@index([status])
  @@map("accounts")
}

model JournalTransaction {
  id             String            @id @default(uuid())
  idempotencyKey String            @unique
  type           TransactionType
  status         TransactionStatus @default(POSTED)
  description    String
  initiatedById  String
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  initiatedBy    User              @relation("TransactionInitiator", fields: [initiatedById], references: [id], onDelete: Restrict)
  ledgerEntries  LedgerEntry[]

  @@index([idempotencyKey])
  @@index([type])
  @@index([status])
  @@index([createdAt])
  @@map("journal_transactions")
}

model LedgerEntry {
  id            String          @id @default(uuid())
  transactionId String
  accountId     String
  direction     LedgerDirection
  amount        Decimal         @db.Decimal(18, 4)
  balanceAfter  Decimal         @db.Decimal(18, 4)
  createdAt     DateTime        @default(now())

  transaction   JournalTransaction @relation(fields: [transactionId], references: [id], onDelete: Restrict)
  account       Account            @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@index([transactionId])
  @@index([accountId])
  @@index([createdAt])
  @@map("ledger_entries")
}

model AuditLog {
  id             String   @id @default(uuid())
  action         String
  actorId        String?
  actorRole      String?
  targetResource String
  targetId       String?
  ipAddress      String?
  userAgent      String?
  metadata       Json?
  createdAt      DateTime @default(now())

  actor          User?    @relation("UserAuditLogs", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([action])
  @@index([actorId])
  @@index([createdAt])
  @@map("audit_logs")
}

model IdempotencyRecord {
  id             String   @id @default(uuid())
  key            String   @unique
  endpoint       String
  requestHash    String
  responseStatus Int
  responseBody   Json
  createdAt      DateTime @default(now())
  expiresAt      DateTime

  @@index([key])
  @@index([expiresAt])
  @@map("idempotency_records")
}
